# Gemini. Without a key the worker falls back to recorded or empty answers, so
# the app still runs. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres. Unset means the app runs on PGlite, an embedded Postgres, with no
# server to install. Fine for development; use a real server in production.
DATABASE_URL=

# Uploaded PDFs. Local filesystem for now.
STORAGE_DIR=.storage

# Independent extraction runs per invoice. Three gives a usable agreement
# signal. One disables the signal entirely.
EXTRACTION_RUNS=3

# OCR for the scanned half. 300 dpi is a starting point, not a settled value:
# raising it fixes some characters and breaks others. Measure before changing.
OCR_DPI=300
OCR_LANGUAGE=eng

# ADR 0002. True means every invoice goes to a human, because the per-field
# error rate has not been measured yet. Only set this false once it has.
COLD_START=true

# Fraction of auto-approved invoices diverted to a human anyway, so the gate's
# false-negative rate keeps being measured rather than assumed.
AUDIT_SAMPLE_RATE=0.05
